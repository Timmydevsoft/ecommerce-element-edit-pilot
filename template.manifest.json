{
  "schemaVersion": 3,
  "templateSource": "ecommerce",
  "templateVersion": "1.1.1",
  "framework": "vite-react-express-monorepo",
  "pageManifestDirectory": "page-manifests",
  "runtime": {
    "appRoot": "client",
    "packageManager": "npm",
    "install": "npm install",
    "dev": {
      "command": "npm run dev",
      "port": 5173,
      "readyPath": "/"
    },
    "entryPoint": "client/src/main.tsx",
    "typecheck": "npm run typecheck",
    "build": "npm run build",
    "start": "npm run start",
    "healthPath": "/api/health"
    ,"annotationBridge": "client/src/lib/annotation-bridge.ts"
  },
  "database": {
    "required": true,
    "migrate": "npm run db:migrate",
    "seed": "npm run db:seed",
    "extensions": [
      "pgcrypto"
    ]
  },
  "branding": {
    "config": "client/src/config/brand.generated.json",
    "assets": "client/public"
  },
  "env": {
    "required": [
      "DATABASE_URL",
      "AUTH_SECRET"
    ]
  },
  "sharedModules": [
    "client/src/components",
    "client/src/config",
    "client/src/layouts",
    "server/src/common"
  ],
  "globalConfig": [
    "client/src/config/brand.generated.json",
    "client/src/config/site-content.json",
    "client/src/index.css"
  ],
  "verification": [
    "typecheck",
    "render"
  ],
  "protectedPaths": [
    "server/src/common/db",
    "server/src/modules/auth",
    "drizzle",
    "drizzle.config.ts",
    "package.json",
    "package-lock.json",
    "client/src/main.tsx",
    "client/src/router.tsx",
    "client/src/api",
    "client/src/hooks",
    "client/src/lib",
    "client/src/types",
    "client/src/navigation",
    "client/src/layouts",
    "client/src/config/app-config.ts",
    "client/src/components/ui",
    "client/src/components/product",
    "client/src/components/price-display.tsx",
    "client/src/components/stock-badge.tsx",
    "client/src/components/quantity-stepper.tsx",
    "client/src/components/brand-mark.tsx",
    "client/src/components/protected-route.tsx",
    "client/src/components/theme-provider.tsx",
    "client/src/components/theme-toggle.tsx"
  ],
  "editableSurfaces": [
    {
      "id": "site.brand",
      "kind": "CONFIG",
      "label": "Brand identity",
      "sourcePath": "client/src/config/brand.generated.json",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_ASSET"
      ],
      "fields": [
        {
          "path": "name",
          "label": "Shop name",
          "type": "text"
        },
        {
          "path": "description",
          "label": "Description",
          "type": "rich_text"
        },
        {
          "path": "tagline",
          "label": "Tagline",
          "type": "text"
        },
        {
          "path": "logoPath",
          "label": "Logo",
          "type": "asset"
        }
      ]
    },
    {
      "id": "site.chrome",
      "kind": "CONFIG",
      "label": "Header and footer wording",
      "page": "*",
      "sourcePath": "client/src/config/site-content.json",
      "operations": [
        "UPDATE_CONTENT"
      ],
      "fields": [
        {
          "path": "header.nav",
          "label": "Header navigation links",
          "type": "json"
        },
        {
          "path": "header.signIn",
