      "fields": [
        { "path": "appearance.textSize", "label": "Heading size", "type": "select", "options": ["text-2xl", "text-3xl", "text-4xl"], "required": true, "generative": false },
        { "path": "appearance.spacing", "label": "Vertical spacing", "type": "select", "options": ["py-12", "py-16", "py-20", "py-24"], "required": true, "generative": false },
        { "path": "appearance.alignment", "label": "Text alignment", "type": "select", "options": ["text-left", "text-center", "text-right"], "required": true, "generative": false },
        { "path": "appearance.background", "label": "Background", "type": "select", "options": ["bg-background", "bg-card", "bg-muted", "bg-primary"], "required": true, "generative": false },
        { "path": "appearance.textColor", "label": "Text colour", "type": "select", "options": ["text-foreground", "text-muted-foreground", "text-primary-foreground"], "required": true, "generative": false },
        { "path": "appearance.visible", "label": "Visible", "type": "boolean", "required": true, "generative": false },
        { "path": "heading", "label": "Heading", "type": "text", "maxLength": 60, "required": true },
        { "path": "lead", "label": "Introduction", "type": "rich_text", "maxLength": 120 }
      ],
      "variants": [
        { "id": "cards", "label": "Four-column cards", "description": "A broad department grid." },
        { "id": "compact", "label": "Compact grid", "description": "A denser three-column department grid." },
        { "id": "list", "label": "Two-column list", "description": "Larger department rows with more room for descriptions." }
      ]
