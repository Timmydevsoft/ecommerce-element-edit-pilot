      "id": "theme.tokens",
      "kind": "DESIGN",
      "label": "Theme tokens",
      "sourcePath": "client/src/index.css",
      "operations": [
        "UPDATE_DESIGN_TOKEN"
      ],
      "fields": [
        {
          "path": "primary",
          "label": "Primary colour",
