    {
      "id": "homepage.hero",
      "kind": "SECTION",
      "label": "Homepage hero",
      "page": "/",
      "sourcePath": "client/src/pages/HomePage.tsx",
      "contentPath": "client/src/content/homepage-hero.json",
      "operations": [
        "UPDATE_CONTENT",
        "REGENERATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT",
        "UPDATE_ASSET",
        "CREATE_COMPONENT_VARIANT"
      ],
      "selector": "[data-section=\"homepage.hero\"]",
      "directManipulation": { "textSize": { "path": "appearance.textSize" }, "spacing": { "path": "appearance.spacing" }, "alignment": { "path": "appearance.alignment" }, "background": { "path": "appearance.background" }, "textColor": { "path": "appearance.textColor" }, "visibility": { "path": "appearance.visible" } },
      "fields": [
        { "path": "appearance.textSize", "label": "Heading size", "type": "select", "options": ["text-3xl", "text-4xl", "text-5xl", "text-6xl"], "required": true, "generative": false },
        { "path": "appearance.spacing", "label": "Vertical spacing", "type": "select", "options": ["py-12", "py-16", "py-20", "py-24", "py-28"], "required": true, "generative": false },
        { "path": "appearance.alignment", "label": "Text alignment", "type": "select", "options": ["text-left", "text-center", "text-right"], "required": true, "generative": false },
        { "path": "appearance.background", "label": "Background", "type": "select", "options": ["bg-background", "bg-card", "bg-muted", "bg-primary"], "required": true, "generative": false },
        { "path": "appearance.textColor", "label": "Text colour", "type": "select", "options": ["text-foreground", "text-muted-foreground", "text-primary-foreground"], "required": true, "generative": false },
        { "path": "appearance.visible", "label": "Visible", "type": "boolean", "required": true, "generative": false },
        { "path": "eyebrow", "label": "Eyebrow", "type": "text", "maxLength": 48 },
        { "path": "headline", "label": "Headline", "type": "text", "maxLength": 90, "required": true },
        { "path": "primaryAction.label", "label": "Primary button", "type": "text", "maxLength": 28, "required": true },
        { "path": "primaryAction.to", "label": "Primary link target", "type": "text", "generative": false, "required": true },
        { "path": "secondaryAction.label", "label": "Secondary button", "type": "text", "maxLength": 28 },
        { "path": "secondaryAction.to", "label": "Secondary link target", "type": "text", "generative": false, "required": true },
        {
          "path": "assurances", "label": "Reassurance points", "type": "list", "required": true, "min": 1, "max": 3,
          "itemFields": [
            { "path": "id", "label": "Reassurance id", "type": "text", "generative": false, "required": true },
            { "path": "title", "label": "Reassurance title", "type": "text", "maxLength": 32, "required": true },
            { "path": "text", "label": "Reassurance text", "type": "rich_text", "maxLength": 150, "required": true }
          ]
        }
      ],
      "variants": [
        { "id": "split", "label": "Split showcase", "description": "Copy and assurances beside the product collage. The safe default for a shop front that should show its products from the first screen." },
        { "id": "centered", "label": "Centred story", "description": "Centred copy with the product collage below. Right when the headline is short and the store should feel calm and deliberate." },
        { "id": "editorial", "label": "Editorial", "description": "A wider story column with a smaller product collage. Right when the words carry the store: a longer headline or a stronger point of view." },
        { "id": "compact", "label": "Compact banner", "description": "A short full-width band with the headline and buttons on one line and the assurances as a single slim row, without the product collage. Right when the hero should take little height and let the departments and products below lead." }
      ]
    },
    {
      "id": "homepage.categories",
      "kind": "SECTION",
