        { "path": "appearance.visible", "label": "Visible", "type": "boolean", "required": true, "generative": false },
        { "path": "heading", "label": "Heading", "type": "text", "maxLength": 60, "required": true },
        { "path": "lead", "label": "Introduction", "type": "rich_text", "maxLength": 120 },
        { "path": "action.label", "label": "Browse link", "type": "text", "maxLength": 28, "required": true },
        { "path": "action.to", "label": "Browse link target", "type": "text", "generative": false, "required": true },
        { "path": "emptyMessage", "label": "Empty-state message", "type": "text", "maxLength": 90, "required": true }
